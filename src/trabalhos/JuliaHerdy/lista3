def faturamento_total(lista_vendas):
    total = 0.0
    for item in lista_vendas:
        total += item['preço unitario'] * item['quantidade']
    return total

def maior_faturamento(lista_vendas):
    maior_faturamento = 0
    produto_maior = ''
    for item in lista_vendas:
        faturamento_item = item['preço unitario'] * item['quantidade']
        if faturamento_item > maior_faturamento:
            maior_faturamento = faturamento_item
            produto_maior = item['produto']
    return produto_maior, maior_faturamento

